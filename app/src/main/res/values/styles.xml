<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Styles -->
    <style name="TextAppearance.Pluto.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/pluto_text_primary</item>
        <item name="android:textSize">@dimen/text_xxl</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Pluto.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/pluto_text_primary</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Pluto.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/pluto_text_secondary</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <style name="TextAppearance.Pluto.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/pluto_text_muted</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Pluto.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/pluto_gold</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Pluto.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/pluto_gold</item>
        <item name="android:textColor">@color/pluto_gold</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.Pluto.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="cardElevation">@dimen/elevation_small</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Input Styles -->
    <style name="Widget.Pluto.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_large</item>
        <item name="boxStrokeColor">@color/pluto_gold</item>
        <item name="hintTextColor">@color/pluto_text_muted</item>
    </style>
</resources>