<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alamat Pengiriman"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Masukkan alamat lengkap" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Metode Pembayaran"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbCOD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COD" />

                    <RadioButton
                        android:id="@+id/rbBankBRI"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bank BRI" />

                    <RadioButton
                        android:id="@+id/rbBankBCA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bank BCA" />

                    <RadioButton
                        android:id="@+id/rbQris"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QRIS" />

                    <RadioButton
                        android:id="@+id/rbDana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DANA" />

                    <RadioButton
                        android:id="@+id/rbOvo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OVO" />

                    <RadioButton
                        android:id="@+id/rbGopay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GoPay" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opsi Pengiriman"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgShipping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbJNE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JNE" />

                    <RadioButton
                        android:id="@+id/rbJNT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="J&amp;T" />

                    <RadioButton
                        android:id="@+id/rbSicepat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sicepat" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/pluto_primary"
            android:text="Buat Pesanan" />

    </LinearLayout>

</ScrollView>
